# ログイン情報は ../.env の TIGERS_ID / TIGERS_PASSWORD のみ共有します。
# このファイルにはタイガースコレクション固有の設定だけを置きます。

ORICAL_BASE_URL=https://tigerscollection.orical.jp
ORICAL_LOGIN_URL=https://tigerscollection.orical.jp/login/tigers?redirect=%2Fgame

# 対戦1回に使うスタミナ（1 / 2 / 3）
MATCH_STAMINA=1

# true の場合、確定操作をせず対象だけ確認します
DRY_RUN=false
